generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  HELD
  CONFIRMED
  CANCELLED_BY_PATIENT
  CANCELLED_BY_LEAVE
  COMPLETED
}

enum LlmStatus {
  OK
  FAILED
  PENDING
}

enum NotificationType {
  EMAIL
  CALENDAR
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum ReminderStatus {
  SCHEDULED
  SENT
  FAILED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())

  doctorProfile      DoctorProfile?
  patientAppointments Appointment[]      @relation("PatientAppointments")
  oauthToken         GoogleOAuthToken?
  notifications      NotificationLog[]
  calendarEvents     CalendarEvent[]
}

model DoctorProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialisation     String
  workingHours       Json
  slotDurationMinutes Int     @default(30)
  createdAt          DateTime @default(now())

  leaves       DoctorLeave[]
  appointments Appointment[] @relation("DoctorAppointments")

  @@index([specialisation])
}

model DoctorLeave {
  id       String        @id @default(uuid())
  doctorId String
  doctor   DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date     DateTime      @db.Date
  reason   String?

  @@unique([doctorId, date])
}

model Appointment {
  id            String            @id @default(uuid())
  patientId     String
  patient       User              @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        DoctorProfile     @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)
  slotStart     DateTime
  slotEnd       DateTime
  status        AppointmentStatus @default(HELD)
  holdExpiresAt DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  symptomForm SymptomForm?
  visitNote   VisitNote?
  notifications NotificationLog[]
  calendarEvents CalendarEvent[]

  // Enforced via a partial unique index added in a raw migration (see migration.sql):
  // one active (HELD or CONFIRMED) appointment per doctor per slotStart.
  @@index([doctorId, slotStart])
  @@index([patientId])
}

model SymptomForm {
  id                String      @id @default(uuid())
  appointmentId     String      @unique
  appointment       Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  rawSymptoms       String
  urgency           String?
  chiefComplaint    String?
  suggestedQuestions Json?
  llmStatus         LlmStatus   @default(PENDING)
  createdAt         DateTime    @default(now())
}

model VisitNote {
  id             String      @id @default(uuid())
  appointmentId  String      @unique
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctorNotes    String
  prescription   Json
  patientSummary String?
  llmStatus      LlmStatus   @default(PENDING)
  createdAt      DateTime    @default(now())

  reminders MedicationReminder[]
}

model MedicationReminder {
  id             String         @id @default(uuid())
  visitNoteId    String
  visitNote      VisitNote      @relation(fields: [visitNoteId], references: [id], onDelete: Cascade)
  medicationName String
  frequency      String
  nextSendAt     DateTime
  status         ReminderStatus @default(SCHEDULED)

  @@index([nextSendAt, status])
}

model NotificationLog {
  id             String             @id @default(uuid())
  type           NotificationType
  appointmentId  String?
  appointment    Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  recipientId    String
  recipient      User               @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  status         NotificationStatus @default(PENDING)
  retryCount     Int                @default(0)
  payload        Json
  lastError      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status, retryCount])
}

model GoogleOAuthToken {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String
  expiryDate   DateTime
}

model CalendarEvent {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleEventId String
  status        String      @default("active")

  @@unique([appointmentId, userId])
}
